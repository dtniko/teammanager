# ===============================================
# SPORTCLUB MANAGER - ENVIRONMENT VARIABLES
# ===============================================
# Copia questo file in .env e configura i valori

# ===============================================
# DATABASE CONFIGURATION
# ===============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportclub_manager
DB_USER=sportclub_user
DB_PASSWORD=your_secure_database_password

# Per produzione, puoi usare anche DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ===============================================
# AUTHENTICATION & SECURITY
# ===============================================
# JWT Secret - DEVE essere una stringa lunga e sicura (min 32 caratteri)
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters_long

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ===============================================
# SERVER CONFIGURATION
# ===============================================
NODE_ENV=development
PORT=5000

# Frontend URL (per CORS e redirect)
FRONTEND_URL=http://localhost:3000

# Force HTTPS in produzione
FORCE_HTTPS=false

# ===============================================
# REDIS CONFIGURATION (opzionale)
# ===============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ===============================================
# EMAIL CONFIGURATION
# ===============================================
# Provider email (Gmail, SendGrid, Mailgun, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# Mittente predefinito
EMAIL_FROM=Sport Manager <noreply@yourdomain.com>

# ===============================================
# PUSH NOTIFICATIONS (PWA)
# ===============================================
# Genera le chiavi VAPID su https://vapidkeys.com/
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ===============================================
# FILE UPLOAD CONFIGURATION
# ===============================================
# Dimensione massima file in byte (default: 10MB)
MAX_FILE_SIZE=10485760

# Directory per upload
UPLOAD_PATH=./server/uploads

# Tipi di file permessi
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# ===============================================
# SUPABASE STORAGE (documenti atleti)
# ===============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DOCUMENTS_BUCKET=documents

# ===============================================
# LOGGING CONFIGURATION
# ===============================================
# Livello di log (error, warn, info, debug)
LOG_LEVEL=info

# Log delle query SQL (true/false)
LOG_QUERIES=false

# Directory per i log
LOG_DIR=./logs

# Rotazione log (days)
LOG_RETENTION_DAYS=30

# ===============================================
# BACKUP CONFIGURATION
# ===============================================
# Backup automatico (true/false)
BACKUP_ENABLED=true

# Directory backup
BACKUP_DIR=./backups

# Retention backup (days)
BACKUP_RETENTION_DAYS=30

# Orario backup giornaliero (formato cron)
BACKUP_SCHEDULE=0 3 * * *

# ===============================================
# MONITORING & ANALYTICS
# ===============================================
# Sentry per error tracking (opzionale)
SENTRY_DSN=your_sentry_dsn

# Google Analytics (opzionale)
GA_TRACKING_ID=your_google_analytics_id

# Health check endpoint
HEALTH_CHECK_TOKEN=your_health_check_secret_token

# ===============================================
# EXTERNAL INTEGRATIONS (opzionali)
# ===============================================
# Integrazione con federazioni sportive
FIGC_API_KEY=your_figc_api_key
CONI_API_KEY=your_coni_api_key

# Integrazione pagamenti (Stripe, PayPal, etc.)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# SMS Provider (Twilio, etc.)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ===============================================
# DEVELOPMENT CONFIGURATION
# ===============================================
# Popola database con dati di test (true/false)
SEED_TEST_DATA=true

# Abilita debug mode
DEBUG_MODE=true

# Hotreload per development
HOT_RELOAD=true

# ===============================================
# PRODUCTION CONFIGURATION
# ===============================================
# Dominio per certificati SSL
DOMAIN=yourdomain.com
WWW_DOMAIN=www.yourdomain.com

# Email per Let's Encrypt
SSL_EMAIL=admin@yourdomain.com

# Rate limiting (requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15

# Session configuration
SESSION_SECRET=your_session_secret
SESSION_TIMEOUT=7200

# ===============================================
# DOCKER CONFIGURATION
# ===============================================
# Database per Docker
POSTGRES_DB=sportclub_manager
POSTGRES_USER=sportclub_user
POSTGRES_PASSWORD=your_postgres_password

# Redis per Docker
REDIS_PASSWORD=your_redis_password

# ===============================================
# CDN & STORAGE (opzionali)
# ===============================================
# AWS S3 per file storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your-s3-bucket-name

# Cloudflare per CDN
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# ===============================================
# WEBHOOK CONFIGURATION
# ===============================================
# Webhook per notifiche esterne
WEBHOOK_URL=https://hooks.slack.com/your_webhook_url
WEBHOOK_SECRET=your_webhook_secret

# ===============================================
# API KEYS & TOKENS
# ===============================================
# Google Maps (per geolocalizzazione campi)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Weather API (per condizioni meteo)
WEATHER_API_KEY=your_weather_api_key

# ===============================================
# FEATURE FLAGS
# ===============================================
# Abilita/disabilita funzionalità specifiche
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_UPLOAD=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BACKUP=true
ENABLE_ANALYTICS=true
ENABLE_PAYMENTS=false

# ===============================================
# CACHE CONFIGURATION
# ===============================================
# TTL cache in secondi
CACHE_TTL=300

# Prefisso chiavi cache
CACHE_PREFIX=sportclub

# ===============================================
# CORS CONFIGURATION
# ===============================================
# Origini permesse (separate da virgola)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===============================================
# DATABASE POOL CONFIGURATION
# ===============================================
# Numero massimo connessioni
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ===============================================
# ADMIN CONFIGURATION
# ===============================================
# Email admin di default (primo accesso)
ADMIN_EMAIL=admin@yourdomain.com

# Numero massimo admin
MAX_ADMIN_USERS=5

# ===============================================
# LOCALE & TIMEZONE
# ===============================================
# Locale per date e formattazione
LOCALE=it-IT

# Timezone
TZ=Europe/Rome

# ===============================================
# TESTING CONFIGURATION
# ===============================================
# Environment per test
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/sportclub_test

# Disabilita notifiche durante i test
DISABLE_NOTIFICATIONS_IN_TEST=true

# ===============================================
# PERFORMANCE CONFIGURATION
# ===============================================
# Timeout per richieste HTTP (ms)
HTTP_TIMEOUT=30000

# Limite payload (byte)
PAYLOAD_LIMIT=50mb

# Compressione GZIP
ENABLE_COMPRESSION=true

# ===============================================
# LEGAL & COMPLIANCE
# ===============================================
# GDPR compliance
GDPR_ENABLED=true

# Cookie consent
COOKIE_CONSENT_REQUIRED=true

# Data retention (days)
DATA_RETENTION_DAYS=2555

# ===============================================
# SOCIAL MEDIA INTEGRATION (opzionale)
# ===============================================
# Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Instagram
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# ===============================================
# CUSTOM BRANDING
# ===============================================
# Nome società
COMPANY_NAME=Your Sport Club Name
COMPANY_LOGO_URL=https://yourdomain.com/logo.png
COMPANY_WEBSITE=https://yourdomain.com

# Colori personalizzati (hex)
PRIMARY_COLOR=#2563eb
SECONDARY_COLOR=#64748b

# ===============================================
# NOTES
# ===============================================
# 1. Modifica TUTTI i valori "your_*" con i tuoi dati reali
# 2. In produzione, usa sempre PASSWORD sicure e casuali
# 3. Non committare mai il file .env su Git
# 4. Usa variabili d'ambiente specifiche per ogni ambiente (dev, staging, prod)
# 5. Per le chiavi API, verifica sempre le limitazioni e i costi
# 6. Monitora regolarmente l'uso delle risorse esterne

